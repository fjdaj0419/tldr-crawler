{
  "manifest_version": 3,
  "name": "TL;DR Crawler",
  "version": "2.2.4",
  "description": "一只会爬行的蜘蛛，跟随你的光标阅读网页，高亮关键句并把要点织成一张 TL;DR 蛛网（支持 DeepSeek / Claude）。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TL;DR Crawler — 点击启动 / 关闭蜘蛛",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html"
}
